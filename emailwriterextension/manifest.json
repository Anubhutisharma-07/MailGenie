{
  "name": "MailGenie - AI Email Writer",
  "description": "AI-powered email reply generator for Gmail",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:8080/*",
    "*://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["*://mail.google.com/*"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "emailwriterextension/icons/icon16.png",
    "32": "emailwriterextension/icons/icon48.png",
    "48": "emailwriterextension/icons/icon48.png",
    "128": "emailwriterextension/icons/icon128.png"
  },
  "action": {
    "default_title": "MailGenie Settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "emailwriterextension/icons/icon16.png",
      "32": "emailwriterextension/icons/icon48.png",
      "48": "emailwriterextension/icons/icon48.png",
      "128": "emailwriterextension/icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [ "emailwriterextension/icons/*" ],
      "matches": ["*://mail.google.com/*"]
    }
  ]
}